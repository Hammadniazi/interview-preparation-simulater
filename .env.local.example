# Required — Groq API key (free): https://console.groq.com
GROQ_API_KEY=

# Optional — Supabase, for history that survives clearing the browser.
# Without these, history is stored in the browser only.
# Run supabase/schema.sql in the Supabase SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # server-only; never expose this to the browser

# Optional — override the Groq model (default: openai/gpt-oss-120b)
# GROQ_MODEL=
